# Copy this file to .env.container and set an empty, dedicated host directory.
# The migration command creates immutable verified snapshot/ and writable runtime/ here;
# it never mutates the source.
VIDEOBOX_CONTAINER_DATA_ROOT=D:/AI_Workspace_louis_office_50/20_project/65_videobox-project
VIDEOBOX_WEB_PORT=5173

# 유진이 쓰는 로컬 모델을 바꾸는 자리. LM Studio에 다른 모델(예: Gemma)을 불러온 뒤
# 이 값을 그 모델의 key로 바꾸면 된다 -- 코드를 고칠 필요가 없다. key는 LM Studio의
# http://127.0.0.1:1234/api/v1/models 응답에서 확인할 수 있다.
# 비워 두면 qwen3-35b를 기본값으로 쓴다. 실제 로드된 모델과 다르면
# `.\scripts\owner-ready.ps1 -Mode Check`가 잡아 준다.
VIDEOBOX_LOCAL_MODEL_NAME=
POSTGRES_DB=videobox
POSTGRES_USER=videobox
POSTGRES_PASSWORD=replace-before-starting

# The gateway uses the plaintext password to authenticate to Hermes.
# Hermes receives only the matching password hash. The plaintext and hash must match.
HERMES_YUJIN_GATEWAY_USERNAME=replace-before-starting
HERMES_YUJIN_GATEWAY_PASSWORD=replace-before-starting
HERMES_YUJIN_GATEWAY_PASSWORD_HASH=replace-before-starting
VIDEOBOX_AGENT_GATEWAY_SERVICE_TOKEN=replace-before-starting

# D2 memory is optional. Leaving MEM0_API_KEY empty keeps interactive Yujin chat
# available with memory storage disabled. The adapter token is separate from the
# API-to-gateway service token and is shared only by gateway and memory adapter.
VIDEOBOX_HERMES_MEMORY_ADAPTER_TOKEN=replace-before-starting
MEM0_API_KEY=

# C3 uses one coordinated Ed25519 key pair. The private key is delivered only
# to Agent Gateway; the matching public key is delivered only to workspace API.
# Replace all three together while admissions are quiesced.
VIDEOBOX_HERMES_CAPABILITY_PRIVATE_KEY_B64=replace-before-starting
VIDEOBOX_HERMES_CAPABILITY_PUBLIC_KEY_B64=replace-before-starting
VIDEOBOX_HERMES_CAPABILITY_KEY_ID=replace-before-starting

# owner가 자산을 넣는 **한 폴더**와, 자산 가치가 없는 것이 가는 자리
# (owner 승인 2026-09-07, `decisions/2026-09-07-one-drop-folder-sorted-for-me.ko.md`).
#
# 원드라이브를 쓰면 휴대폰에서 넣은 것도 내려온다. 구글 드라이브 `G:`는
# 스트리밍이라 Docker가 빈 폴더로 본다 -- 쓰려면 미러링으로 바꿔야 한다.
#
# **버리는 자리는 감시 폴더 밖이어야 한다.** 감시기가 하위 폴더까지 훑어서,
# 안에 두면 옮긴 파일을 다음 바퀴에 다시 읽는다.
VIDEOBOX_OWNER_DROP_ROOT=C:/Users/<사용자>/OneDrive/#_videobox
VIDEOBOX_OWNER_DROP_REJECT_ROOT=C:/Users/<사용자>/OneDrive/#_videobox_불필요

# 캡컷으로 넘기기 — 보통은 **아무것도 안 적어도 된다.**
#
# 초안에 적히는 소재 경로를 이 컴퓨터의 경로로 옮겨 적는 대응표는
# 위 VIDEOBOX_CONTAINER_DATA_ROOT에서 저절로 만들어진다
# (`/videobox-data=<그 값>/runtime`). 자리를 특별하게 쓰는 경우에만 아래를 적는다.
# `;`로 여러 쌍을 적을 수 있고, 구분자는 `/`로 쓴다.
#VIDEOBOX_CAPCUT_HOST_PATH_MAP=/videobox-data=D:/.../runtime
#
# 캡컷 폴더에 실제로 넣어 주는 다리(이 컴퓨터의 127.0.0.1:8200). VideoBox를
# 켜면 `owner-ready.ps1`이 창 없이 함께 띄운다. 손으로 켜려면:
#   pwsh -File scripts/start-capcut.ps1
#VIDEOBOX_CAPCUT_BRIDGE_URL=http://host.docker.internal:8200
#
# **실제로 열어 본 캡컷 버전만** 통과시킨다. 기본은 8.7. / 8.9. / 9.3.
# (9.3.0.3970은 2026-09-07에 실물로 확인). 새 버전을 쓰면 열어 본 뒤 여기 더한다.
#VIDEOBOX_CAPCUT_SUPPORTED_VERSIONS=8.7.,8.9.,9.3.
