# Hermes Agent 버전 pin — SSOT.
#
# 이 저장소가 참조하는 nousresearch/hermes-agent 이미지는 여기 적힌 값
# 하나가 정답이다. 다른 곳(compose.yaml, compose.hermes-yujin.yaml,
# docker/hermes-memory-adapter.Dockerfile, scripts/start-hermes-yujin.ps1,
# scripts/verify-hermes-yujin-runtime.ps1, scripts/verify-hermes-yujin-zero-tools.ps1,
# scripts/verify-hermes-oauth-bootstrap.ps1)는 같은 다이제스트를 복사해서
# 들고 있고, `tests/test_hermes_agent_pin_consistency.py`가 그 복사본들이
# 여기와 어긋나면 실패한다. 2026-08-27에 11개 파일이 서로 다른 시점에
# 손으로 고쳐지면서 어긋날 뻔한 것을 겪고 나서 만들었다.
#
# 올릴 때 순서:
#   1. https://hub.docker.com/r/nousresearch/hermes-agent/tags 에서 최근에
#      올라오고 며칠 지나 안정된(당일 올라온 태그는 쓰지 않는다) 태그를 고른다.
#   2. `docker pull nousresearch/hermes-agent:<태그>`로 받고 다이제스트를 확인한다.
#   3. 이 파일 세 값을 갱신한다.
#   4. `git grep -l <옛 다이제스트>`로 남은 자리가 있는지 확인하고 전부 옮긴다.
#   5. `.venv/Scripts/python.exe -m pytest tests/test_hermes_agent_pin_consistency.py
#      tests/test_compose_contract.py tests/test_hermes_yujin_compose_contract.py
#      tests/test_hermes_zero_tools_verifier.py
#      tests/test_platform_only_hermes_dashboard_contract.py -q`로 확인한다.
#   6. `scripts/start-hermes-yujin.ps1`로 재기동하고 유진 채팅이 되는지 확인한다.

HERMES_AGENT_VERSION_TAG=v2026.8.19
HERMES_AGENT_IMAGE_DIGEST=sha256:3811ed13da874fba2ac99b6d492db9a203d34cb6dccf90d886948c00d0ccec09
HERMES_AGENT_IMAGE_REF=nousresearch/hermes-agent@sha256:3811ed13da874fba2ac99b6d492db9a203d34cb6dccf90d886948c00d0ccec09
