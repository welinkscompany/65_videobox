    "rules": [
      {
        "label": "이음매 가드 전체 (바뀐 파일에 걸린 것만 배차)",
        "path_globs": [
          "**"
        ],
        "commands": [
          ".venv/Scripts/python.exe scripts/guard_router.py --changed --speed all"
        ]
      },
      {
        "label": "백엔드 (core-engine·api·mcp·gateway 등)",
        "path_globs": [
          "packages/**/*.py",
          "services/**/*.py",
          "tests/**/*.py",
          "scripts/**/*.py",
          "pyproject.toml"
        ],
        "commands": [
          ".venv/Scripts/python.exe -m pytest -q -p no:cacheprovider --ignore=tests/test_mcp_server.py <바뀐 파일에 걸린 tests/...>",
          "합칠 단위가 닫히면 전체: .venv/Scripts/python.exe -m pytest -q -p no:cacheprovider --ignore=tests/test_mcp_server.py tests  (약 40분, 혼자 돌린다 — bare pytest·시스템 Python 결과는 근거가 아니다)"
        ]
      },
      {
        "label": "웹 화면 (타입·단위)",
        "path_globs": [
          "apps/web/**/*.ts",
          "apps/web/**/*.tsx",
          "apps/web/**/*.css",
          "apps/web/package.json",
          "apps/web/vite.config.*",
          "apps/web/tsconfig*.json"
        ],
        "commands": [
          "cd apps/web && npx tsc --noEmit",
          "cd apps/web && npx vitest run"
        ]
      },
      {
        "label": "웹 화면 (가짜 API e2e·실물 흐름)",
        "path_globs": [
          "apps/web/src/**",
          "apps/web/e2e/**",
          "apps/web/e2e-real/**",
          "apps/web/playwright*.mjs"
        ],
        "commands": [
          "cd apps/web && npm run test:e2e  (혼자 돌린다. 4173 포트 점거부터 확인 — fast-path §10.18)",
          "cd apps/web && npm run test:e2e:real-flow -- <바뀐 화면에 맞는 e2e-real/*.spec.mjs>",
          "그리고 화면에서 직접 밟는다 — CLAUDE.md §4 완료의 정의"
        ]
      },
      {
        "label": "편집기 화면 반입 출처 해시",
        "path_globs": [
          "apps/web/src/app/**",
          "apps/web/src/features/editor/**",
          "apps/web/src/components/ui/**",
          "docs/oss/editor-ui-source-map.json"
        ],
        "commands": [
          ".venv/Scripts/python.exe -m pytest -q -p no:cacheprovider tests/test_editor_ui_source_provenance.py"
        ]
      },
      {
        "label": "지침·인계·범위 문서",
        "path_globs": [
          "CLAUDE.md",
          ".claude/rules/**",
          "docs/handoffs/**",
          "docs/development-fast-path.ko.md",
          "docs/implementation-plan.ko.md",
          "docs/decisions/**"
        ],
        "commands": [
          ".venv/Scripts/python.exe -m pytest -q -p no:cacheprovider tests/test_handoff_entry_point.py tests/test_documentation_contract.py tests/test_handoff_freshness_guard.py"
        ]
      },
      {
        "label": "훅·가드 표",
        "path_globs": [
          ".claude/settings.json",
          ".claude/harness-policy.json",
          "scripts/guard_router.py"
        ],
        "commands": [
          ".venv/Scripts/python.exe -m pytest -q -p no:cacheprovider tests/test_guard_router_table.py",
          "python D:/AI_Workspace_louis_office_50/10_workspace/_reference/harness/tests/wiring_check.py .claude/settings.json ."
        ]
      },
      {
        "label": "컨테이너 설정 (켜고 끄지 말 것 — 계약 테스트만)",
        "path_globs": [
          "compose*.yaml",
          "docker/**",
          "scripts/owner-ready.ps1"
        ],
        "commands": [
          ".venv/Scripts/python.exe -m pytest -q -p no:cacheprovider tests/test_compose_contract.py",
          "컨테이너 재생성은 루이스 대표님 판단 — scripts/owner-ready.ps1 로만"
        ]
      }
    ]
