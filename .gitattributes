# 컨테이너 안에서 실행되는 셸 스크립트. Windows에서 CRLF로 받으면 shebang이
# 깨져 `exec /app/docker/workspace-entrypoint.sh: no such file or directory`로
# 죽는다 -- 오래된 worktree는 이미 LF로 받아 둬서 보이지 않고, 새로 만든
# worktree에서만 터진다. 실제로 2026-08-10에 그렇게 걸렸다.
*.sh text eol=lf
docker/workspace-supervisor.py text eol=lf

# 자막 글꼴은 받아 온 바이트 그대로여야 한다. sha256이 provenance.json에 걸려
# 있고 tests/test_caption_fonts.py가 그것을 다시 잰다.
assets/fonts/korean/*.ttf binary
assets/fonts/korean/*.otf binary
assets/fonts/korean/licenses/*.txt text eol=lf

# 아이콘 글꼴도 같은 이유로 못박는다. 라이선스 원문의 줄바꿈이 체크아웃마다
# 달라지면 sha256이 흔들려 tests/test_icon_font_asset.py가 Windows에서만 터진다.
assets/fonts/icons/*.ttf binary
assets/fonts/icons/licenses/*.txt text eol=lf
